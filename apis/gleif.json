{
  "openapi": "3.0.3",
  "info": {
    "title": "GLEIF LEI API (the operations realm-fibo-gleif uses)",
    "version": "v1",
    "description": "Hand-curated from https://www.gleif.org/en/lei-data/gleif-api and the live service, 12-13 November 2026. JSON:API envelopes: lists under data[*], singles under data. Data: GLEIF Golden Copy, CC0 1.0 under the LEI Data Terms of Use."
  },
  "servers": [
    {
      "url": "https://api.gleif.org/api/v1"
    }
  ],
  "paths": {
    "/lei-records": {
      "get": {
        "operationId": "gleifLeiRecords",
        "summary": "LEI records by LEI, up to 200 per call (filter[lei]=A,B,C), or by fulltext / legal name / country / status filters.",
        "parameters": [
          {
            "name": "filter[lei]",
            "in": "query",
            "required": false,
            "description": "Comma-separated LEIs, at most 200.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter[fulltext]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter[entity.legalName]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter[entity.legalAddress.country]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter[entity.status]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "INACTIVE"
              ]
            }
          },
          {
            "name": "page[size]",
            "in": "query",
            "required": false,
            "description": "Records per page, at most 200.",
            "schema": {
              "type": "integer",
              "maximum": 200
            }
          },
          {
            "name": "page[number]",
            "in": "query",
            "required": false,
            "description": "1-based page.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of records.",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "description": "One lei-records resource: id is the LEI; attributes.entity carries legalName, otherNames, legalAddress, jurisdiction, legalForm, status, registeredAs, registeredAt.",
                        "properties": {
                          "type": {
                            "type": "string"
                          },
                          "id": {
                            "type": "string"
                          },
                          "attributes": {
                            "type": "object",
                            "properties": {
                              "lei": {
                                "type": "string"
                              },
                              "entity": {
                                "type": "object",
                                "properties": {
                                  "legalName": {
                                    "type": "object",
                                    "properties": {
                                      "name": {
                                        "type": "string"
                                      },
                                      "language": {
                                        "type": "string"
                                      }
                                    }
                                  },
                                  "otherNames": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "properties": {
                                        "name": {
                                          "type": "string"
                                        },
                                        "type": {
                                          "type": "string"
                                        }
                                      }
                                    }
                                  },
                                  "legalAddress": {
                                    "type": "object",
                                    "properties": {
                                      "city": {
                                        "type": "string"
                                      },
                                      "country": {
                                        "type": "string"
                                      },
                                      "postalCode": {
                                        "type": "string"
                                      }
                                    }
                                  },
                                  "jurisdiction": {
                                    "type": "string"
                                  },
                                  "category": {
                                    "type": "string"
                                  },
                                  "status": {
                                    "type": "string"
                                  },
                                  "legalForm": {
                                    "type": "object",
                                    "properties": {
                                      "id": {
                                        "type": "string"
                                      }
                                    }
                                  },
                                  "registeredAs": {
                                    "type": "string"
                                  },
                                  "registeredAt": {
                                    "type": "object",
                                    "properties": {
                                      "id": {
                                        "type": "string"
                                      }
                                    }
                                  },
                                  "creationDate": {
                                    "type": "string"
                                  }
                                }
                              },
                              "registration": {
                                "type": "object",
                                "properties": {
                                  "status": {
                                    "type": "string"
                                  },
                                  "lastUpdateDate": {
                                    "type": "string"
                                  },
                                  "corroborationLevel": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
