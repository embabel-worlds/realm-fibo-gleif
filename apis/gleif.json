                                    },
                                    "language": {
                                      "type": "string"
                                    }
                                  }
                                },
                                "otherNames": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "name": {
                                        "type": "string"
                                      },
                                      "type": {
                                        "type": "string"
                                      }
                                    }
                                  }
                                },
                                "legalAddress": {
                                  "type": "object",
                                  "properties": {
                                    "city": {
                                      "type": "string"
                                    },
                                    "country": {
                                      "type": "string"
                                    },
                                    "postalCode": {
                                      "type": "string"
                                    }
                                  }
                                },
                                "jurisdiction": {
                                  "type": "string"
                                },
                                "category": {
                                  "type": "string"
                                },
                                "status": {
                                  "type": "string"
                                },
                                "legalForm": {
                                  "type": "object",
                                  "properties": {
                                    "id": {
                                      "type": "string"
                                    }
                                  }
                                },
                                "registeredAs": {
                                  "type": "string"
                                },
                                "registeredAt": {
                                  "type": "object",
                                  "properties": {
                                    "id": {
                                      "type": "string"
                                    }
                                  }
                                },
                                "creationDate": {
                                  "type": "string"
                                }
                              }
                            },
                            "registration": {
                              "type": "object",
                              "properties": {
                                "status": {
                                  "type": "string"
                                },
                                "lastUpdateDate": {
                                  "type": "string"
                                },
                                "corroborationLevel": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No such LEI."
          }
        }
      }
    },
